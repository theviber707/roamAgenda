<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <Chronometer
        android:id="@+id/notification_chronometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:textSize="28sp"
        android:textStyle="bold"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/notification_task_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="3"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/notification_task_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Line2"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <LinearLayout
        android:id="@+id/notification_actions_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">

            <ImageButton
                android:id="@+id/notification_action_done"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/notification_button_done_bg"
                android:src="@drawable/ic_action_done"
                android:scaleType="fitCenter"
                android:padding="10dp"
                android:focusable="false"
                android:contentDescription="@string/clock_out_and_done" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">

            <ImageButton
                android:id="@+id/notification_action_pause_resume"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/notification_button_bg"
                android:src="@drawable/ic_action_pause"
                android:scaleType="fitCenter"
                android:padding="10dp"
                android:focusable="false"
                android:contentDescription="@string/pause_clock" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">

            <ImageButton
                android:id="@+id/notification_action_stop"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/notification_button_bg"
                android:src="@drawable/ic_action_stop"
                android:scaleType="fitCenter"
                android:padding="11dp"
                android:focusable="false"
                android:contentDescription="@string/clock_out" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">

            <ImageButton
                android:id="@+id/notification_action_cancel"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/notification_button_bg"
                android:src="@drawable/ic_action_cancel"
                android:scaleType="fitCenter"
                android:padding="11dp"
                android:focusable="false"
                android:contentDescription="@string/cancel" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
